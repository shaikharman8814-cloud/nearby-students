rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Help: Auth check
    function signedIn() { return request.auth != null; }

    // --- DEVELOPMENT FIRST: UNBLOCK ALL READS ---
    // We allow everyone to read for development, but only signed-in students can write.
    
    match /{document=**} {
      // Permit reading everything to fix Discovery/Feeds/Birthdays immediately
      allow read: if true;
      
      // Permit writing ONLY for signed-in students
      allow write: if signedIn();
    }

    // --- SPECIFIC OVERRIDES ---
    
    // Feedback is special: anyone can submit (anonymous)
    match /Feedback/{id} {
      allow create: if true;
      allow read: if false; 
    }

    // Admin/System collections: strictly locked down
    match /xp_ledger/{id} {
      allow read, write: if false;
    }
    
    match /reports/{id} {
      allow create: if signedIn();
      allow read: if false;
    }
  }
}

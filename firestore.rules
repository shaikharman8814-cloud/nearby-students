rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Does the record belong to the current user?
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Check if user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Strict Users collection rules
    match /users/{userId} {
      // Profiles are discoverable but only by students in the system
      allow read: if isAuthenticated();
      // Users can only edit their own profile
      allow write: if isOwner(userId);
    }
    
    // Connections (DMs) - Only involved users can see/write
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow write: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.users);
      }
    }

    // Groups - only members can read/write
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (resource.data.privacy == 'open' || request.auth.uid in resource.data.members);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.admins);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.admins);

      // Group Channels
      match /channels/{channelId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
      }
    }

    // Q&A Posts
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      
      // Answers
      match /answers/{answerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Resources (Notes, papers)
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.uploaderId == request.auth.uid;
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Stories
    match /stories/{storyId} {
        allow read: if isAuthenticated();
        // Stories are usually transient, only author or system should write
        allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Projects
    match /projects/{projectId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
        
        // Applications
        match /applications/{applicationId} {
            allow create: if isAuthenticated();
            allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid);
            allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid);
        }
    }

    // Catch-all: DENY ALL (MANDATORY SECURITY PRACTICE)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

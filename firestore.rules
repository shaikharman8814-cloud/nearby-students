rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Does the record belong to the current user?
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Check if user is an admin
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Strict Users collection rules
    match /users/{userId} {
      // Only students can read profiles
      allow read: if isAuthenticated();
      // Only the account owner can edit their own profile
      allow write: if isOwner(userId);
      
      // Notifications subcollection
      match /notifications/{notifId} {
        // Only the recipient can see their notifications
        allow read: if isOwner(userId);
        // Notifications are system-generated or by other users during interactions
        allow create: if isAuthenticated(); 
        // Only the recipient can mark as read
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'opened']);
      }
    }
    
    // Connections (DMs) - Only involved users can see/write
    match /connections/{connectionId} {
      // Security: Only students involved in the chat can see it exists
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      
      // Security: Creator must be part of the chat they are creating
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      
      // Security: Only participants can update (e.g., last message, unread counts)
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.users);
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated(); // Allow discovery
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.admins);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.admins);

      match /channels/{channelId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
      }
      
      // Group Messages
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
      }

      // Group Join Requests
      match /requests/{userId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins);
      }
    }

    // Feed Posts
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Security: Validate author and timestamp
      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.createdAt == request.time;
                    
      allow update: if isAuthenticated() && 
                    resource.data.authorId == request.auth.uid &&
                    (request.resource.data.authorId == resource.data.authorId); // Cannot change author
                    
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // Security: Validate commentator identity
        allow create: if isAuthenticated() && 
                      request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && userId == request.auth.uid;
      }
    }

    // Q&A Posts
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      // Security: Validate questioner identity
      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      
      match /answers/{answerId} {
        allow read: if isAuthenticated();
        // Security: Validate answerer identity
        allow create: if isAuthenticated() && 
                      request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      // Security: Validate uploader and prevent impersonation
      allow create: if isAuthenticated() && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uploaderId == request.auth.uid;
    }

    // Projects
    match /projects/{projectId} {
        allow read: if isAuthenticated();
        // Security: Validate founder identity
        allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Project Members
    match /project_members/{memberId} {
      allow read: if isAuthenticated();
      // Security: You can only 'join' a project as yourself
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Security: Only admins can manage memberships, or users can leave (delete)
      allow update: if isAdmin();
      allow delete: if isAdmin() || (resource.data.userId == request.auth.uid);
    }

    // Applications (Project Hiring)
    match /applications/{applicationId} {
        // Security: Only the applicant or the project founder can see the application details
        allow read: if isAuthenticated() && (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.founderUid);
        
        // Security: You can't apply for someone else
        allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
        
        // Security: Founder can update status, applicant can withdraw
        allow update: if isAuthenticated() && (request.auth.uid == resource.data.applicantUid || request.auth.uid == resource.data.founderUid);
        
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.applicantUid;
    }

    // Calls Signaling
    match /calls/{callId} {
        // Security: ONLY the caller and receiver can see the call signal. Prevents 'Handshake Hijacking'.
        allow create: if isAuthenticated() && request.resource.data.callerId == request.auth.uid;
        allow read, update, delete: if isAuthenticated() && (
            resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid
        );
    }

    // Call History (Private Logs)
    match /call_history/{historyId} {
      // Security: History is private to the two students and Admins
      allow create: if isAuthenticated() && request.resource.data.fromUser == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.fromUser == request.auth.uid || resource.data.toUser == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Stories
    match /stories/{storyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'likedBy'])
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Games (Mafia, etc.)
    match /games/{gameId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.hostId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid)).id); 
      // Simplified check for participants: they must have a player doc
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(playerId) || (get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid);
      }

      match /secrets/{userId} {
        allow read: if isOwner(userId) || (get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid && get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'GAME_OVER');
        allow write: if get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid;
      }

      match /actions/{actorId} {
        allow read, write: if isOwner(actorId) || (get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
